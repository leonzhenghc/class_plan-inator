# Copy this file to `.env` and fill in the two values from your Supabase project
# (Dashboard → Project Settings → API). Restart `npm run dev` after editing.
#
# Use the anon / publishable key only. It is designed to be shipped in the
# browser and is safe there because row-level security restricts what it can
# reach. NEVER put the service_role key in here — it bypasses RLS entirely and
# anything in a VITE_ variable is bundled into the public JavaScript.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
